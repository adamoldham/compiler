program p is
  i : integer;
  r : real;
  s : string;
  c : constant integer := 3;
  procedure swap(a : ref integer; b : ref integer) is
    t : integer;
  begin
    t := a; a := b; b := t;
  end swap;
  procedure show(n : value integer; msg : value string) is
  begin
    writeln msg & int2string(n);
  end show;
  function half(x : value real) return real is
  begin
    return x / 2;
  end half;
  function seven return integer is begin return 7; end seven;
begin
  i := seven;
  r := half(i);
  r := half(3.5) + i;
  swap(i, i);
  show(c, "n = ");
  show(i + 1, "x");
  read i, r;
  read (i);
  write i, r, s;
  writeln;
  s := int2string(i) & real2string(r);
  r := int2real(i);
  i := real2int(r);
end p;
