program edges is
	i, n : integer;
	b : boolean;

	procedure outer is
		procedure inner is
		begin
			null;
		end inner;
	begin
		inner;
	end;
begin
	b := not i = n;
	b := odd i and i in 1..9;
	b := i in 1 .. n + 1;
	for k in reverse 1..10 loop
		exit when k = 5;
	end loop;
	while not b loop
		b := true;
	end loop;
	pragma debug(on);
	write (1);
	writeln (1, 2);
	writeln;
	return;
end wrong_name;

-- the grammar rejects these (each would report one error), so they are not tested here:
--   write (a + b) * c;           ( after write is the wrapper paren, then * is unexpected
--   if (x > 3) then              a relop is not allowed inside ( <simple_expr> )
--   c : constant integer := -5;  only a literal is allowed after :=, with no sign
--   x := eof;                    eof is not in the grammar
